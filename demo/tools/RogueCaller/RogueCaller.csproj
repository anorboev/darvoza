<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Darvoza.Demo.RogueCaller</RootNamespace>
    <AssemblyName>RogueCaller</AssemblyName>
    <!-- Manual demo utility: it is NOT a test project and has no reference to the gateway. It talks to a
         running gateway over the wire like any other MCP client, so `dotnet test` never touches it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Client half of the official C# MCP SDK, pinned to the same 1.4.0 the gateway uses. -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

</Project>

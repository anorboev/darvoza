# Copy to .env (gitignored) and fill in. NEVER commit real values.

# Azure DevOps org name (just the org, e.g. "contoso" from dev.azure.com/contoso)
ADO_ORG=your-azure-devops-org

# Least-privilege Azure DevOps PAT for the upstream official MCP server.
# Scope it to the throwaway demo org only. Read + minimal write for the demo.
AZURE_DEVOPS_EXT_PAT=

# Caller API keys -> roles (wired up in A01-T3 via policy.yaml). Spike (T1) ignores these.
DARVOZA_KEY_ANALYST=
DARVOZA_KEY_ENGINEER=
